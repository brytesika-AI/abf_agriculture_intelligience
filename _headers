# Cloudflare Pages — cache control headers

# Never cache the HTML shell or service worker
# Forces the browser to always fetch fresh versions
/index.html
  Cache-Control: no-store, must-revalidate

/sw.js
  Cache-Control: no-store, must-revalidate

/manifest.json
  Cache-Control: no-store, must-revalidate

# Static assets (icons, etc.) — cache aggressively
/icon-192.png
  Cache-Control: public, max-age=31536000, immutable

/icon-512.png
  Cache-Control: public, max-age=31536000, immutable
